rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isGroupAdmin(groupId) {
      return signedIn() &&
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    match /profiles/{profileId} {
      allow read: if true;
      allow create: if signedIn();
      allow update: if signedIn();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /fx_rates/{rateId} {
      allow read: if true;
      allow write: if false;
    }

    match /groups/{groupId} {
      allow read: if isGroupMember(groupId);
      allow create: if signedIn();
      allow update, delete: if isGroupAdmin(groupId);

      match /members/{memberId} {
        allow read: if isGroupMember(groupId);
        allow create: if signedIn() && (isGroupAdmin(groupId) || memberId == request.auth.uid);
        allow update: if isGroupAdmin(groupId);
        allow delete: if isGroupAdmin(groupId) || (signedIn() && memberId == request.auth.uid);
      }
    }

    match /expenses/{expenseId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if signedIn() && isGroupMember(request.resource.data.groupId) && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && isGroupMember(resource.data.groupId) && resource.data.createdBy == request.auth.uid;
      allow delete: if signedIn() && isGroupMember(resource.data.groupId) && (resource.data.createdBy == request.auth.uid || isGroupAdmin(resource.data.groupId));

      match /participants/{participantId} {
        allow read: if isGroupMember(get(/databases/$(database)/documents/expenses/$(expenseId)).data.groupId);
        allow create, update, delete: if signedIn() && isGroupMember(get(/databases/$(database)/documents/expenses/$(expenseId)).data.groupId);
      }
    }

    match /payments/{paymentId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if signedIn() && isGroupMember(request.resource.data.groupId) && request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && isGroupMember(resource.data.groupId) && (resource.data.createdBy == request.auth.uid || isGroupAdmin(resource.data.groupId));
    }

    match /recurring_expenses/{id} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if signedIn() && isGroupMember(request.resource.data.groupId) && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.createdBy == request.auth.uid || isGroupAdmin(resource.data.groupId));
    }
  }
}
