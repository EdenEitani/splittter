# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ─── Supabase ──────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Firebase (target backend) ─────────────────────────────────
# Found in: Firebase console -> Project Settings -> General -> Your apps (Web)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# ─── Migration scripts env vars (local only) ───────────────────
# SUPABASE_URL=https://your-project-ref.supabase.co
# Option A (preferred): SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Option B (no DB password reset): use anon key + user login
# VITE_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_EMAIL=you@example.com
# SUPABASE_PASSWORD=your-supabase-password
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json
# MIGRATION_OUT_DIR=migration
# MIGRATION_IN_FILE=migration/supabase-export.json

# ─── GitHub Pages Base Path (optional) ────────────────────────
# Set to /your-repo-name/ if hosting in a subpath on GitHub Pages
# e.g. VITE_BASE_PATH=/splittter/
# Leave empty or as / for custom domain or root hosting
VITE_BASE_PATH=/

# ─── Edge Function Secrets (set in Supabase Dashboard) ────────
# These are set in Supabase → Edge Functions → Secrets, NOT in .env.local

# OpenAI API key for LLM categorization (optional; falls back to heuristics)
# OPENAI_API_KEY=sk-...

# Optional: Premium FX API key from exchangerate-api.com for higher rate limits
# FX_API_KEY=your-fx-api-key

# Optional: Secret token for authenticating the GitHub Actions FX refresh call
# FX_REFRESH_SECRET=your-secret-token
